#!/bin/sh
# The installer's window in the live desktop: starts the installer (as root)
# on 127.0.0.1, shows its page in a window (Qt WebEngine, else WebKitGTK),
# stops it on close.
set -u
url=http://127.0.0.1:8475/
qml=/usr/lib/graveyard/installer/window.qml
if ! python3 -c "import socket; socket.create_connection(('127.0.0.1', 8475), 1)" 2> /dev/null; then
  sudo -n /usr/bin/graveyard-installer > "${XDG_RUNTIME_DIR:-/tmp}/graveyard-installer.log" 2>&1 &
  server=$!
  i=0
  until python3 -c "import socket; socket.create_connection(('127.0.0.1', 8475), 1)" 2> /dev/null; do
    i=$((i + 1)); [ "$i" -lt 50 ] || break; sleep 0.2
  done
fi
# Qt WebEngine when the image has it, else WebKitGTK, else a browser
if [ -e /usr/lib/qt6/qml/QtWebEngine/qmldir ]; then
  for tool in qml6 /usr/lib/qt6/bin/qml qml; do
    if command -v "$tool" > /dev/null 2>&1; then
      "$tool" "$qml" -- "$url"
      status=$?
      break
    fi
  done
fi
if [ "${status:-1}" -ne 0 ] && python3 -c "import gi; gi.require_version('WebKit', '6.0')" 2> /dev/null; then
  python3 /usr/lib/graveyard/installer/window-gtk.py "$url"
  status=$?
fi
if [ "${status:-1}" -ne 0 ]; then
  xdg-open "$url" 2> /dev/null || echo "open $url"
  wait
fi
[ -n "${server:-}" ] && sudo -n kill "$server" 2> /dev/null
exit 0
