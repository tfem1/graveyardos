# replaces: git
# Git for the recipes that cherry-pick, apply or describe in prepare(); built
# without curl (sources are cloned on the build host, never in the chroot)
name = git
version = 2.56.1
release = 0
desc = The fast distributed version control system (bootstrap, no network transports)
url = https://git-scm.com
license = GPL-2.0-only
source = https://www.kernel.org/pub/software/scm/git/git-2.56.1.tar.xz
sha256 = TODO

@build
cd git-2.56.1
make prefix=/usr gitexecdir=/usr/lib/git-core NO_TCLTK=1 NO_CURL=1 NO_PYTHON=1 NO_GETTEXT=1 INSTALL_SYMLINKS=1 all

@package
cd git-2.56.1
make prefix=/usr gitexecdir=/usr/lib/git-core NO_TCLTK=1 NO_CURL=1 NO_PYTHON=1 NO_GETTEXT=1 INSTALL_SYMLINKS=1 \
  DESTDIR="$PKGDIR" install
