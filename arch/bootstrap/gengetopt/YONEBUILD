# Arch's gengetopt is built from Git, whose tree lacks the cmdline.c that
# gengetopt generates for itself (Arch's makedepends name gengetopt). This
# is the GNU release before Arch's (2.23, with it generated), installed as
# "gengetopt" at a lower version so that the one built from source
# replaces it as an upgrade. No "# replaces:" line.
name = gengetopt
version = 2.23
release = 0
desc = A tool to write command line option parsing code for C programs (bootstrap)
url = https://www.gnu.org/software/gengetopt/
license = GPL-3.0-or-later
source = https://ftp.gnu.org/gnu/gengetopt/gengetopt-2.23.tar.xz
sha256 = TODO

@build
cd gengetopt-2.23
# 2019's gnulib and C++: the language versions of their day
./configure --prefix=/usr CFLAGS="-O2 -std=gnu17" CXXFLAGS="-O2 -std=gnu++14"
make -j1

@package
cd gengetopt-2.23
make -j1 DESTDIR="$PKGDIR" install
rm -f "$PKGDIR/usr/share/info/dir"
