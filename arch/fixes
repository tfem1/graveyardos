docbook-xml	eval "graveyard_$(declare -f package)"; package() { graveyard_package; install -d "$pkgdir/usr/lib/graveyard" "$pkgdir/usr/share/yone/hooks"; printf '%s\n' '#!/bin/sh' '# docbook-xml in the XML catalog, as the docbook-xml.install of Arch does (Yone runs no install scripts)' 'c=/etc/xml/catalog' '[ -f $c ] || xmlcatalog --noout --create $c' 'xmlcatalog --noout --add delegatePublic "-//OASIS//ENTITIES DocBook XML" file:///etc/xml/docbook-xml $c' 'xmlcatalog --noout --add delegatePublic "-//OASIS//DTD DocBook XML" file:///etc/xml/docbook-xml $c' 'xmlcatalog --noout --add delegateSystem http://www.oasis-open.org/docbook/ file:///etc/xml/docbook-xml $c' 'xmlcatalog --noout --add delegateURI http://www.oasis-open.org/docbook/ file:///etc/xml/docbook-xml $c' > "$pkgdir/usr/lib/graveyard/docbook-xml-catalog"; chmod 755 "$pkgdir/usr/lib/graveyard/docbook-xml-catalog"; printf '%s\n' 'desc = Registering DocBook XML in the XML catalog' 'paths = etc/xml/docbook-xml usr/share/xml/docbook/' 'on = install upgrade' 'run = /usr/lib/graveyard/docbook-xml-catalog' > "$pkgdir/usr/share/yone/hooks/30-docbook-xml-catalog.hook"; }  # Arch registers it in /etc/xml/catalog from its .install script, which Yone does not run: a Yone hook does (xsltproc then finds the stylesheets offline)
docbook-xsl	eval "graveyard_$(declare -f package)"; package() { graveyard_package; install -d "$pkgdir/usr/lib/graveyard" "$pkgdir/usr/share/yone/hooks"; printf '%s\n' '#!/bin/sh' '# docbook-xsl in the XML catalog, as the docbook-xsl.install of Arch does (Yone runs no install scripts)' 'c=/etc/xml/catalog' '[ -f $c ] || xmlcatalog --noout --create $c' 'for nons in /usr/share/xml/docbook/xsl-stylesheets-*-nons; do' '  [ -d "$nons" ] || continue' '  v=${nons##*/xsl-stylesheets-}; v=${v%-nons}; ns=/usr/share/xml/docbook/xsl-stylesheets-$v' '  for ver in $v current; do' '    for x in rewriteSystem rewriteURI; do' '      xmlcatalog --noout --add $x http://cdn.docbook.org/release/xsl/$ver $ns $c' '      xmlcatalog --noout --add $x http://cdn.docbook.org/release/xsl-nons/$ver $nons $c' '      xmlcatalog --noout --add $x http://docbook.sourceforge.net/release/xsl-ns/$ver $ns $c' '      xmlcatalog --noout --add $x http://docbook.sourceforge.net/release/xsl/$ver $nons $c' '    done' '  done' 'done' > "$pkgdir/usr/lib/graveyard/docbook-xsl-catalog"; chmod 755 "$pkgdir/usr/lib/graveyard/docbook-xsl-catalog"; printf '%s\n' 'desc = Registering the DocBook XSL stylesheets in the XML catalog' 'paths = usr/share/xml/docbook/' 'on = install upgrade' 'run = /usr/lib/graveyard/docbook-xsl-catalog' > "$pkgdir/usr/share/yone/hooks/30-docbook-xsl-catalog.hook"; }  # Arch registers it in /etc/xml/catalog from its .install script, which Yone does not run: a Yone hook does (xsltproc then finds the stylesheets offline)
libxml2	eval "$(declare -f build | sed 's/-D legacy=enabled/& -D python=enabled -D http=enabled -D history=enabled/')"  # meson.build takes these with .enabled(), not .allowed(): Arch gets them from --auto-features enabled, ours is auto (the Python bindings itstool imports, xmllint --history)
gtk-doc	eval "$(declare -f build | sed 's/arch-meson gtk-doc build/& -D tests=false/')"  # its test suite (on by default) makes meson require the parameterized Python module, a check dependency; check() is not run
flac	command -v pandoc >/dev/null || eval "$(declare -f build | sed 's/-D NDEBUG=ON/& -D INSTALL_MANPAGES=OFF/')"; eval "$(declare -f package_flac | sed 's#mv {"\${pkgdir}",doc}/usr/share/doc#mkdir -p "${pkgdir}"/usr/share/doc; &#')"  # without pandoc (Haskell, built later) no manual pages: CMake stops unless told; and no API reference without doxygen to split off
dav1d	eval "$(declare -f build | sed "s/-Denable_docs='true'/-Denable_docs='false'/; s#ninja -C build all doc/html#ninja -C build all#")"  # no HTML API reference (dav1d-doc: arch/drop): graphviz is built minimal, with no PNG output for doxygen's graphs
libarchive	export ac_cv_lib_charset_locale_charset=no  # a libcharset (GNU libiconv's) in the chroot makes archive_version_details.c read _libiconv_version, which glibc's iconv.h has not
fontconfig	command -v docbook2html >/dev/null || eval "$(declare -f build | sed 's/-D doc-html=enabled/-D doc-html=disabled/')"  # no HTML manual without docbook-utils (arch/drop): built before it, as the font stack's first base
curl	eval "$(declare -f build | sed '/build-curl-gnutls;$/,/libcurl-gnutls\.so\.4/d')"  # no third, GnuTLS build (libcurl-gnutls: arch/drop)
libngtcp2	eval "$(declare -f build | sed 's/--with-gnutls/--without-gnutls/')"  # no GnuTLS crypto helper (arch/drop); the OpenSSL one is found by configure
gnutls	eval "$(declare -f build | sed 's/--with-tpm2/--without-tpm2/')"  # no TPM 2.0 (tpm2-tss: arch/drop), which closed the curl, gnutls, tpm2-tss cycle
libsasl	eval "$(declare -f build | sed 's/--enable-sql/--disable-sql/; s| --with-mysql=/usr||; s| --with-pgsql=/usr/lib||')"  # no sql plugin (MariaDB, PostgreSQL: arch/drop), which package() removes anyway: configure links it to libmysqlclient and libpq when told
ffmpeg	eval "$(declare -f build | sed 's/ --enable-vapoursynth / /')"  # no VapourSynth input (arch/drop): configure stops on an --enable-* whose library is missing
pulseaudio	eval "$(declare -f package_pulseaudio | sed '/_pick lirc /d')"  # no module-lirc to split off (pulseaudio-lirc, lirc: arch/drop; meson auto feature)
