# Shell lines run after a package base's PKGBUILD is read (arch/import.py),
# for what Arch's build of the day does not meet here.
# base<TAB>line
unifdef	CFLAGS+=" -std=gnu17"  # its own "constexpr" variable: a keyword in C23, gcc's default
simdjson	CXXFLAGS+=" -Wno-error -Wno-free-nonheap-object"  # its tests are built with -Werror, which a newer gcc's warnings break
go	eval "graveyard_$(declare -f package)"; package() { graveyard_package; rm "$pkgdir/usr/lib/go/doc"; }  # Arch's /usr/lib/go/doc -> /usr/share/doc/go link: a directory in the bootstrap go it upgrades (Yone: "is a directory on disk")
python-babel	sed -i -e "s/^FILENAME = .*/FILENAME = 'cldr-common-$_core.0.zip'/" -e "s/if digest != FILESUM:/if False:  # the PKGBUILD pins the CLDR it gives/" "$srcdir/babel-$pkgver/scripts/download_import_cldr.py"  # make import-cldr downloads CLDR 47 unless given it; the PKGBUILD gives 46 (Arch downloads at build time)
mercurial	sed -i -e "s/^if not ssl.HAS_TLSv1_2:/if not (ssl.HAS_TLSv1_2 or ssl.HAS_TLSv1_3):/" "$srcdir/mercurial-$pkgver/setup.py"; sed -i -e "s/^if getattr(ssl, .HAS_TLSv1_2., hasattr(ssl, .PROTOCOL_TLSv1_2.)):/if True:/" "$srcdir/mercurial-$pkgver/mercurial/sslutil.py"  # Python against OpenSSL 4 (no TLSv1_2_method) says HAS_TLSv1_2 False, though TLS 1.2 works
libdv	echo 'AC_DEFUN([AM_PATH_SDL], [m4_default([$3], [:])])' > "$srcdir/libdv-$pkgver/acinclude.m4"  # SDL 1.2's sdl.m4 is not built (makedepends sdl); --enable-sdl is off, autoreconf only needs the macro defined (libdv has no acinclude.m4)
libsonic	CFLAGS+=" -fPIC"  # Arch's ldflags.patch drops the Makefile's -fPIC, and sonic.o goes into libsonic.so: gcc's default PIE code reaches stderr by a PC32 relocation, refused in a shared object
fast_float	eval "$(declare -f build | sed 's/-DFASTFLOAT_TEST=ON/-DFASTFLOAT_TEST=OFF/')"  # its tests fetch supplemental_test_files from GitHub at configure time (no network here), and check() is not run
anari-sdk	eval "$(declare -f build | sed 's|-DCMAKE_INSTALL_PREFIX=/usr|& -DBUILD_HELIDE_DEVICE=OFF|')"  # the example "helide" device downloads Embree 4.3.3 at configure time (no network here)
libdicom	eval "$(declare -f build | sed 's/arch-meson build "\$pkgname"/& -D tests=false/')"  # the tests need check (a check dependency, not built), and meson stops without it
openucx	eval "$(declare -f build | sed 's|--with-cuda=/opt/cuda|--without-cuda|; s|--with-rocm=/opt/rocm|--without-rocm|')"  # GPU compute is not built (arch/long, arch/drop)
openucc	eval "$(declare -f build | sed 's|--with-cuda=/opt/cuda|--without-cuda --without-nccl|; s|--with-rocm=/opt/rocm|--without-rocm --without-rccl|')"  # GPU compute is not built (arch/long, arch/drop)
openmpi	eval "$(declare -f build | sed 's|--with-cuda=/opt/cuda --with-cuda-libdir=/usr/lib|--without-cuda|; s|--with-rocm=/opt/rocm|--without-rocm|')"  # GPU compute is not built (arch/long, arch/drop)
openimagedenoise	eval "$(declare -f build | sed 's/-DOIDN_DEVICE_CUDA=ON/-DOIDN_DEVICE_CUDA=OFF/; s/-DOIDN_DEVICE_HIP=ON/-DOIDN_DEVICE_HIP=OFF/')"; eval "$(declare -f package | sed 's|rm -r "\${pkgdir}"/build|rm -rf "${pkgdir}"/build|')"  # GPU compute is not built (arch/long, arch/drop); the build/ the GPU devices install may then be missing
adios2	eval "$(declare -f build | sed 's/-DADIOS2_USE_CUDA=ON/-DADIOS2_USE_CUDA=OFF/')"  # GPU compute is not built (arch/long, arch/drop)
opencv	eval "$(declare -f build | sed '/local cuda_archs=/d; /build-cuda/d')"  # the second, CUDA build (opencv-cuda, python-opencv-cuda: arch/drop) is not made
hspell	eval "$(declare -f package_hunspell-he | sed "/qtwebengine/d; s/^\( *\)_filename=.*/\1: ;/")"  # no qt6-webengine (arch/long): hunspell-he without its Qt WebEngine dictionaries
doxygen	eval "$(declare -f build | sed 's/-Dbuild_doc:BOOL=ON/-Dbuild_doc:BOOL=OFF/; s/-Dbuild_wizard:BOOL=ON/-Dbuild_wizard:BOOL=OFF/; s/-Duse_sys_spdlog:BOOL=ON/-Duse_sys_spdlog:BOOL=OFF/; s/-Duse_sys_fmt:BOOL=ON/-Duse_sys_fmt:BOOL=OFF/; s/-Duse_libclang:BOOL=ON/-Duse_libclang:BOOL=OFF/; /--target docs/d')"; eval "$(declare -f package_doxygen | sed 's|_pick \$pkgbase-docs usr/share/doc|:|')"  # built early, minimal (arch/drop): no manual (doxygen-docs), doxywizard nor libclang; its bundled fmt and spdlog
graphviz	eval "$(declare -f build | sed 's/--enable-python3=yes/--disable-python3/; s|\./configure --prefix=/usr|& --disable-swig --disable-sharp --disable-guile --disable-lua --disable-r --disable-perl --disable-php --disable-ruby --disable-java --disable-go --disable-d --disable-javascript --without-pangocairo --without-libgd --without-freetype2 --without-rsvg --without-ghostscript --without-poppler --without-lasi --without-webp --without-gts --without-ann --without-qt --without-gdk --without-gdk-pixbuf --without-gtk --without-gtkgl --without-gtkglext --without-glade --without-glut --without-smyrna --without-devil --without-aalib --without-x|')"  # built early, minimal (arch/drop): core renderers (SVG, PostScript, dot, json...) and layouts, the Tcl tcldot; none found later in the chroot is taken in
graphviz	eval "graveyard_$(declare -f package)"; package() { graveyard_package; LD_LIBRARY_PATH="$pkgdir/usr/lib" GVBINDIR="$pkgdir/usr/lib/graphviz" "$pkgdir/usr/bin/dot" -c; }  # the plugin list (usr/lib/graphviz/config8, plugin file names) Arch's graphviz.install makes with "dot -c": without it dot knows no layout nor format, and Yone runs no install scripts
python-pygments	eval "$(declare -f build | sed '/make -C doc html/d')"; eval "$(declare -f package | sed '/doc\/_build\/html/d; /mkdir -vp "\$pkgdir\/usr\/share\/doc"/d')"  # its HTML documentation needs python-sphinx, which needs it (arch/drop): built early for gi-docgen
wayland	eval "$(declare -f build | sed "s/arch-meson \$pkgbase-\$pkgver build/& -D documentation=false/")"; eval "$(declare -f package_wayland | sed "s|mv \"\$pkgdir\"/usr/share/{doc,man} docs/share|mv \"\$pkgdir\"/usr/share/{doc,man} docs/share 2> /dev/null \|\| true|")"  # no documentation (arch/drop): wayland is built early; wayland-docs is left empty
glib2	graveyard_build=$(declare -f build)  # glib2 is built before gobject-introspection, gi-docgen, python-docutils and sysprof (their cycle): as GNOME's bootstrap, without what they bring; Arch's options when they are there
glib2	command -v g-ir-scanner >/dev/null || eval "$(declare -f build | sed 's/-D introspection=enabled/-D introspection=disabled/; s/-D documentation=true/-D documentation=false/')"  # no GIR (gobject-introspection), and no API reference, which is made from it
glib2	command -v gi-docgen >/dev/null && command -v rst2html5 >/dev/null || eval "$(declare -f build | sed 's/-D documentation=true/-D documentation=false/')"  # the API reference needs gi-docgen and docutils' rst2html5
glib2	command -v rst2man >/dev/null || eval "$(declare -f build | sed 's/-D man-pages=enabled/-D man-pages=disabled/')"  # the manual pages need docutils' rst2man
glib2	pkg-config --exists sysprof-capture-4 || eval "$(declare -f build | sed 's/-D sysprof=enabled/-D sysprof=disabled/')"  # libsysprof-capture (sysprof's) is not built yet; meson's fallback would download it
glib2	[ "$(declare -f build)" = "$graveyard_build" ] || { eval "$(declare -f _pick | sed 's/d="\$srcdir\/\$p\//[ -e "$f" ] || continue; &/')"; eval "$(declare -f package_glib2-docs | sed 's#mv docs/\* "\$pkgdir"#[ ! -d docs ] || &#')"; }  # then the docs and manual pages package() splits off may be missing
gobject-introspection	command -v gtkdoc-scan >/dev/null || { eval "$(declare -f build | sed 's/-D gtk_doc=true/-D gtk_doc=false/')"; eval "$(declare -f package_gobject-introspection | sed '/_pick libg usr\/share\/gtk-doc/d')"; }  # built before gtk-doc (their cycle): without its API reference
libxml2	eval "$(declare -f package_libxml2 | sed 's#mv "\$pkgdir"/usr/share/doc -t doc/usr/share#mkdir -p "$pkgdir"/usr/share/doc; &#')"  # built before doxygen and libxslt (their cycle): meson makes the API reference and manual pages only with doxygen and xsltproc, so there may be no usr/share/doc to split off (libxml2-docs is then empty)
check	command -v doxygen >/dev/null || { eval "$(declare -f build | sed 's#make all doc/doxygen doc/check_html#make all doc/check_html#')"; eval "$(declare -f package_check-docs | sed '/check\/doc\/doxygen\/html/d')"; }  # built before doxygen (their cycle): without the API reference
libevent	command -v doxygen >/dev/null || { eval "$(declare -f build | sed 's/-D EVENT__DOXYGEN=ON/-D EVENT__DOXYGEN=OFF/')"; eval "$(declare -f package_libevent | sed 's#mv {"\$pkgdir",doc}/usr/share/doc#mkdir -p "$pkgdir"/usr/share/doc; &#')"; }  # built before doxygen (their cycle): without the API reference (libevent-docs) and its manual pages
aom	command -v doxygen >/dev/null || eval "$(declare -f package_aom-docs | sed '/build\/docs\/html/d')"  # built before doxygen (their cycle): no API reference (aom-docs)
lapack	command -v doxygen >/dev/null || { eval "$(declare -f build | sed 's/-DBUILD_MAN_DOCUMENTATION=ON/-DBUILD_MAN_DOCUMENTATION=OFF/; /--target man/d')"; eval "$(declare -f package_lapack-doc | sed '/build\/DOCS\/man/d; s#rm "\$pkgdir"/usr/share/man/man3/isnan.3#rm -f "$pkgdir"/usr/share/man/man3/isnan.3#')"; }  # built before doxygen (their cycle): no manual pages (lapack-doc)
jsoncpp	command -v doxygen >/dev/null || { eval "$(declare -f build | sed '/Building docs/d; /doxybuild\.py/d')"; eval "$(declare -f package_jsoncpp-doc | sed '/dist\/doxygen/d')"; }  # built before doxygen (their cycle): no API reference (jsoncpp-doc)
libsasl	[ -e /usr/include/ldap.h ] || eval "$(declare -f build | sed 's/--enable-ldapdb/--disable-ldapdb/; s/--with-ldap /--without-ldap /')"  # built before openldap (their cycle with krb5): the ldapdb plugin, which package() removes (cyrus-sasl's), needs it; without krb5, mariadb and postgresql configure leaves out only the plugins package() removes
krb5	eval "$(declare -f build | sed 's/--with-ldap/--without-ldap/')"  # no LDAP back end (arch/drop): krb5 comes first in the krb5, openldap, libsasl cycle
# Qt 5 and KDE Frameworks 5 are not built (arch/drop)
breeze	eval "$(declare -f build | sed '/build5/d')"  # only the Qt6 build (-DBUILD_QT5=OFF): no Qt5 style (breeze5: arch/drop), no KDE Frameworks 5
plasma-integration	eval "$(declare -f build | sed '/build5/d')"  # only the Qt6 build (-DBUILD_QT5=OFF): no Qt5 platform theme (plasma5-integration: arch/drop), no KDE Frameworks 5
sddm	eval "$(declare -f build | sed '/build5/d')"; eval "$(declare -f package | sed '/build5/d')"  # only the Qt6 build (-DBUILD_WITH_QT6=ON): no Qt5 sddm-greeter nor its QML components (arch/drop); themes with QtVersion=6, and the built-in one, use sddm-greeter-qt6
poppler	eval "$(declare -f build | sed 's/-DENABLE_GTK_DOC=ON/& -DENABLE_QT5=OFF/')"  # no Qt5 bindings (poppler-qt5: arch/drop); ENABLE_QT5 is on by default and stops cmake without Qt5
gstreamer	eval "$(declare -f build | sed 's/-D gpl=enabled/& -D qt5=disabled/')"  # no qmlgl plugin (gst-plugin-qmlgl: arch/drop), whatever the chroot has: a libgstqmlgl.so left in root fails gstreamer-docs' leftover check; gst-plugins-good's qt5 yields to this top-level option
libportal	eval "$(declare -f build | sed 's/arch-meson libportal build/& -D backend-qt5=disabled/')"; eval "$(declare -f package_libportal | sed 's/gtk3 gtk4 qt5 qt6/gtk3 gtk4 qt6/')"  # no Qt5 backend (libportal-qt5: arch/drop), and package_libportal has no qt5 files to split off (its mv would fail)
polkit-qt	eval "$(declare -f build | sed '/build5/d')"  # only the Qt6 build (polkit-qt5: arch/drop)
qca	eval "$(declare -f build | sed '/build-qt5/d')"  # only the Qt6 build (qca-qt5: arch/drop)
gpsd	eval "$(declare -f build | sed 's/qt_versioned=5/qt=no/')"  # no Qt5 (arch/drop): without libQgpsmm, whatever the chroot has
zbar	eval "$(declare -f build | sed 's/-D java=disabled/& -D qt=false/')"  # no Qt5 (arch/drop): without the Qt widget, whatever the chroot has
