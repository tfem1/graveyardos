# Shell lines run after a package base's PKGBUILD is read (arch/import.py),
# for what Arch's build of the day does not meet here.
# base<TAB>line
unifdef	CFLAGS+=" -std=gnu17"  # its own "constexpr" variable: a keyword in C23, gcc's default
simdjson	CXXFLAGS+=" -Wno-error -Wno-free-nonheap-object"  # its tests are built with -Werror, which a newer gcc's warnings break
go	eval "graveyard_$(declare -f package)"; package() { graveyard_package; rm "$pkgdir/usr/lib/go/doc"; }  # Arch's /usr/lib/go/doc -> /usr/share/doc/go link: a directory in the bootstrap go it upgrades (Yone: "is a directory on disk")
python-babel	sed -i -e "s/^FILENAME = .*/FILENAME = 'cldr-common-$_core.0.zip'/" -e "s/if digest != FILESUM:/if False:  # the PKGBUILD pins the CLDR it gives/" "$srcdir/babel-$pkgver/scripts/download_import_cldr.py"  # make import-cldr downloads CLDR 47 unless given it; the PKGBUILD gives 46 (Arch downloads at build time)
mercurial	sed -i -e "s/^if not ssl.HAS_TLSv1_2:/if not (ssl.HAS_TLSv1_2 or ssl.HAS_TLSv1_3):/" "$srcdir/mercurial-$pkgver/setup.py"; sed -i -e "s/^if getattr(ssl, .HAS_TLSv1_2., hasattr(ssl, .PROTOCOL_TLSv1_2.)):/if True:/" "$srcdir/mercurial-$pkgver/mercurial/sslutil.py"  # Python against OpenSSL 4 (no TLSv1_2_method) says HAS_TLSv1_2 False, though TLS 1.2 works
libdv	echo 'AC_DEFUN([AM_PATH_SDL], [m4_default([$3], [:])])' > "$srcdir/libdv-$pkgver/acinclude.m4"  # SDL 1.2's sdl.m4 is not built (makedepends sdl); --enable-sdl is off, autoreconf only needs the macro defined (libdv has no acinclude.m4)
libsonic	CFLAGS+=" -fPIC"  # Arch's ldflags.patch drops the Makefile's -fPIC, and sonic.o goes into libsonic.so: gcc's default PIE code reaches stderr by a PC32 relocation, refused in a shared object
fast_float	eval "$(declare -f build | sed 's/-DFASTFLOAT_TEST=ON/-DFASTFLOAT_TEST=OFF/')"  # its tests fetch supplemental_test_files from GitHub at configure time (no network here), and check() is not run
anari-sdk	eval "$(declare -f build | sed 's|-DCMAKE_INSTALL_PREFIX=/usr|& -DBUILD_HELIDE_DEVICE=OFF|')"  # the example "helide" device downloads Embree 4.3.3 at configure time (no network here)
libdicom	eval "$(declare -f build | sed 's/arch-meson build "\$pkgname"/& -D tests=false/')"  # the tests need check (a check dependency, not built), and meson stops without it
openucx	eval "$(declare -f build | sed 's|--with-cuda=/opt/cuda|--without-cuda|; s|--with-rocm=/opt/rocm|--without-rocm|')"  # GPU compute is not built (arch/long, arch/drop)
openucc	eval "$(declare -f build | sed 's|--with-cuda=/opt/cuda|--without-cuda --without-nccl|; s|--with-rocm=/opt/rocm|--without-rocm --without-rccl|')"  # GPU compute is not built (arch/long, arch/drop)
openmpi	eval "$(declare -f build | sed 's|--with-cuda=/opt/cuda --with-cuda-libdir=/usr/lib|--without-cuda|; s|--with-rocm=/opt/rocm|--without-rocm|')"  # GPU compute is not built (arch/long, arch/drop)
openimagedenoise	eval "$(declare -f build | sed 's/-DOIDN_DEVICE_CUDA=ON/-DOIDN_DEVICE_CUDA=OFF/; s/-DOIDN_DEVICE_HIP=ON/-DOIDN_DEVICE_HIP=OFF/')"; eval "$(declare -f package | sed 's|rm -r "\${pkgdir}"/build|rm -rf "${pkgdir}"/build|')"  # GPU compute is not built (arch/long, arch/drop); the build/ the GPU devices install may then be missing
adios2	eval "$(declare -f build | sed 's/-DADIOS2_USE_CUDA=ON/-DADIOS2_USE_CUDA=OFF/')"  # GPU compute is not built (arch/long, arch/drop)
opencv	eval "$(declare -f build | sed '/local cuda_archs=/d; /build-cuda/d')"  # the second, CUDA build (opencv-cuda, python-opencv-cuda: arch/drop) is not made
hspell	eval "$(declare -f package_hunspell-he | sed "/qtwebengine/d; s/^\( *\)_filename=.*/\1: ;/")"  # no qt6-webengine (arch/long): hunspell-he without its Qt WebEngine dictionaries
